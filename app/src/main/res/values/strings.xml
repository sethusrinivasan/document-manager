    <!-- My Trail -->
    <string name="safety_title">My Trail</string>
    <string name="safety_intro">Places stay only on this phone. A notification stays visible while the trail is on. To stop later: menu → My Trail → Stop trail.</string>
    <string name="safety_disclosure_title">Use location for My Trail?</string>
    <string name="safety_disclosure_body">Paperstow will record unique places while you travel, keep them on this phone for 24 hours with the battery level at each save, and show a notification the whole time. Locations are not sent to Paperstow. You can share Maps links yourself when you need to.</string>
